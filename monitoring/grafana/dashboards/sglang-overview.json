{
  "uid": "sglang-overview",
  "title": "SGLang Serving Overview",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "sglang",
    "lab"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sglang\"}",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {},
      "description": "Based on metric names observed on SGLang 0.5.21. Rates/quantiles may be empty when idle or before sufficient samples. Single-model, single-GPU lab."
    },
    {
      "id": 2,
      "title": "Running requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sglang:num_running_reqs{job=\"sglang\"})",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Based on metric names observed on SGLang 0.5.21. Rates/quantiles may be empty when idle or before sufficient samples. Single-model, single-GPU lab."
    },
